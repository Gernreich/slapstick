# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# The cut files and the SolidCraft design are drawn by slapstick.rs; the
# 3D viewer is built from the cut files by viewer.rs (Rust; repro-svg
# builds it), which reads them with lasermade-tools' turn3d module, so it
# expects that checkout beside this one.

# --- the cut files, drawn by slapstick.rs from its parameters (by hand in
# Inkscape until 2026-11-08). The previews and the viewer are built from them. ---
slapstick_happy.svg :: target/release/slapstick --out=$(dirname $OUT)
slapstick_sad.svg :: target/release/slapstick --out=$(dirname $OUT)

# --- the previews: display renderings of the cut files ---
previews/slapstick_happy.svg :: ../lasermade-tools/target/release/make-preview slapstick_happy.svg $OUT
previews/slapstick_sad.svg :: ../lasermade-tools/target/release/make-preview slapstick_sad.svg $OUT

# --- the pages ---
index.html :: ../lasermade-tools/target/release/md2html index.md $OUT
slapstick-3d.html :: target/release/viewer --out=$OUT

# --- the SolidCraft design: the slats and handles as parametric solids,
# written by slapstick.rs, and saved by SolidCraft with the build cache left
# out (lasermade-tools' sc-slim) so the file is the same every time ---
solidcraft/slapstick-comedy-and-tragedy.solidcraft.json :: target/release/slapstick --no-write --solidcraft=$(dirname $OUT)
solidcraft/slapstick-comedy-and-tragedy.sc :: target/release/slapstick --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/slapstick-comedy-and-tragedy.solidcraft.json --save $OUT --quiet && ../lasermade-tools/target/release/sc-slim $OUT

# --- the STEP file, written by SolidCraft (solidcraft-cli, on PATH) from that
# design (by step-export from the 3D view until 2026-11-08) ---
step/slapstick-comedy-and-tragedy.step :: target/release/slapstick --no-write --solidcraft=$(dirname $OUT) && solidcraft-cli run $(dirname $OUT)/slapstick-comedy-and-tragedy.solidcraft.json --out $OUT --quiet
