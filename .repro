# How every shipped SVG and page in this repository is drawn. Checked by
# lasermade-tools' repro-svg; $OUT is where the file must be written.
#
# The 3D viewer is built from the cut files by viewer.py, which imports
# turn3d.py from lasermade-tools, so it expects that checkout beside this one.

# --- the cut files: no command in this repository redraws them. They are
# the source the previews and the viewer are built from. ---
slapstick_happy.svg :: !
slapstick_sad.svg :: !

# --- the previews: display renderings of the cut files ---
previews/slapstick_happy.svg :: ../lasermade-tools/target/release/make-preview slapstick_happy.svg $OUT
previews/slapstick_sad.svg :: ../lasermade-tools/target/release/make-preview slapstick_sad.svg $OUT

# --- the pages ---
index.html :: ../lasermade-tools/target/release/md2html index.md $OUT
slapstick-3d.html :: python3 viewer.py --out=$OUT
